---
import Layout from "../layouts/Layout.astro";
import Landing from "../components/Landing.astro";
import Timeline from "../components/Timeline.astro";
import HistoricalPanel from "../components/HistoricalPanel.astro";
import Simulation from "../components/Simulation.astro";
import CavyInspector from "../components/CavyInspector.astro";
import SelectionPanel from "../components/SelectionPanel.astro";
import GenerationSummary from "../components/GenerationSummary.astro";
import FinalComparison from "../components/FinalComparison.astro";
---

<Layout title="Interactive Guinea Pig Domestication">
  <Landing />

  <div class="game-view" data-testid="game-view" hidden>
    <section class="hero">
      <h2 tabindex="-1" data-testid="hero-heading">Interactive Guinea Pig Domestication</h2>
    </section>

    <Timeline />

    <div class="workspace">
      <div class="left-column">
        <GenerationSummary />
        <HistoricalPanel />
      </div>
      <Simulation />
      <div class="sidebar">
        <CavyInspector />
        <SelectionPanel />
      </div>
    </div>

    <FinalComparison />
  </div>
</Layout>

<script>
  import "../scripts/landing";
  import "../scripts/app";
</script>
