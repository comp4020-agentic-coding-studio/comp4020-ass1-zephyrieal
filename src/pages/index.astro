---
import Layout from "../layouts/Layout.astro";
import Timeline from "../components/Timeline.astro";
import HistoricalPanel from "../components/HistoricalPanel.astro";
import Simulation from "../components/Simulation.astro";
import CavyInspector from "../components/CavyInspector.astro";
import SelectionPanel from "../components/SelectionPanel.astro";
import GenerationSummary from "../components/GenerationSummary.astro";
import FinalComparison from "../components/FinalComparison.astro";
---

<Layout title="Interactive Guinea Pig Domestication">
  <section class="hero">
    <h1>Interactive Guinea Pig Domestication</h1>
    <p class="hero-intro">
      Six thousand years ago, every wild cavy fled anything that moved. Select the
      parents of each new generation and watch a population slowly become something
      else &mdash; run <span class="seed" data-testid="seed"></span>.
    </p>
  </section>

  <Timeline />

  <div class="workspace">
    <div class="left-column">
      <GenerationSummary />
      <HistoricalPanel />
    </div>
    <Simulation />
    <div class="sidebar">
      <CavyInspector />
      <SelectionPanel />
    </div>
  </div>

  <FinalComparison />
</Layout>

<script>
  import "../scripts/app";
</script>
