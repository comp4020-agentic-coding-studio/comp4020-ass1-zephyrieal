<section class="simulation" aria-label="Guinea pig colony" data-testid="simulation-section">
  <h2 class="visually-hidden">Colony</h2>
  <div class="play-area" data-testid="play-area">
    <div class="fence-edge fence-edge-top" aria-hidden="true"></div>
    <div class="fence-edge fence-edge-bottom" aria-hidden="true"></div>
    <div class="fence-edge fence-edge-left" aria-hidden="true"></div>
    <div class="fence-edge fence-edge-right" aria-hidden="true"></div>
  </div>
  <p class="play-area-hint">
    Move your cursor over the colony to see how each cavy reacts. Drag the food and toy
    (or focus them and use the arrow keys) to see how they respond to something other
    than you.
  </p>
</section>
